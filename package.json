{
  "name": "janus-parse",
  "license": "MIT",
  "version": "0.0.0-semantically-released",
  "packageManager": "pnpm@11.24.0",
  "keywords": [
    "html-parser",
    "text-extractor",
    "html-to-text",
    "html-sanitizer",
    "clean-text",
    "strip-tags"
  ],
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/client.d.js",
      "import": "./dist/client/client.js"
    },
    "./server/stream": {
      "types": "./dist/server/stream.d.ts",
      "import": "./dist/server/stream.js"
    },
    "./client/stream": {
      "types": "./dist/client/stream.d.ts",
      "import": "./dist/client/stream.js"
    },
    "./server": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    },
    "./client": {
      "types": "./dist/client/client.d.ts",
      "import": "./dist/client/client.js"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Casneil/janus-parse"
  },
  "homepage": "https://github.com/Casneil/janus-parse",
  "bugs": {
    "url": "https://github.com/Casneil/janus-parse/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "prepack": "pnpm build",
  "scripts": {
    "janus": "tsx ./lib/server.ts",
    "test": "vitest",
    "code:lint": "pnpm eslint --flag unstable_native_nodejs_ts_config --cache .",
    "fmt": "prettier --write .",
    "type:check": "tsc --noEmit",
    "build": "rm -rf ./dist && tsc --project tsconfig.lib.json",
    "build:lib": "tsc --project tsconfig.lib.json",
    "prepublishOnly": "pnpm build",
    "bundle:size": "tsx scripts/bundle-size.ts"
  },
  "dependencies": {
    "node-html-parser": "9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "happy-dom": "^20.12.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "prettier": {},
  "--Typescript V 7--": "cannot use TS v7 until typescript-eslint adds support"
}
